# Copy to .env.local and fill in from Supabase → Project Settings.
# .env.local is git-ignored. Never commit real keys.

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full database access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string (URI). Only used by `yarn db:migrate`.
SUPABASE_DB_URL=

# Order notification emails (resend.com). Optional locally.
RESEND_API_KEY=
ORDER_EMAIL_FROM=B&W Crackers <orders@bwcrackers.com>

NEXT_PUBLIC_SITE_URL=http://localhost:3000
